[sub_resource type="GDScript" id="GDScript_hjyhh"]
script/source = "extends StaticBody2D

var unlocked = false

func _ready() -> void:
	unlocked = false
	set_tint()
	set_themed_skin()

func set_tint() :
	if EventBus.current_theme == 1 : # Reg :
		material.set_shader_parameter(\"tint_color\", Color(1.0, 1.0, 1.0, 1.0))
		# Set tint strength
		material.set_shader_parameter(\"tint_amount\", 0.02)
	elif EventBus.current_theme == 2 : # Ice :
		# Set tint color (RGB)
		material.set_shader_parameter(\"tint_color\", Color(0.067, 0.988, 0.988))
		# Set tint strength
		material.set_shader_parameter(\"tint_amount\", 0.02)
	elif EventBus.current_theme == 3 : # Hell :
		# Set tint color (RGB)
		material.set_shader_parameter(\"tint_color\", Color(0.976, 0.192, 0.298, 1.0))
		# Set tint strength
		material.set_shader_parameter(\"tint_amount\", 0.02)
	elif EventBus.current_theme == 4 : # Overgrown :
		# Set tint color (RGB)
		material.set_shader_parameter(\"tint_color\", Color(0.0, 0.306, 0.078, 1.0))
		# Set tint strength
		material.set_shader_parameter(\"tint_amount\", 0.02)

func set_themed_skin() :
	var theme = EventBus.current_theme
	
	if theme == 1 : # Regular :
		%DoorSprite.play(\"DarkSteel\")
	elif theme == 2 : # Ice :
		%DoorSprite.play(\"DarkSteelIce\")
	elif theme == 3 : # Hell :
		%DoorSprite.play(\"DarkSteelHell\")
	elif theme == 4 : # Overgrown :
		%DoorSprite.play(\"DarkSteelOvergrown\")
"

